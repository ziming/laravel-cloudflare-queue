{
    "name": "ossycodes/laravel-cloudflare-queue",
    "description": "A production-ready Cloudflare Queue driver for Laravel, implementing the full Queue contract.",
    "license": "MIT",
    "keywords": ["laravel", "cloudflare", "queue", "driver"],
    "authors": [
        {
            "name": "Ossy",
            "email": "osaigbovoemmanuel1@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0",
        "mockery/mockery": "^1.5",
        "orchestra/testbench": "^8.0|^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "OssyCodes\\LaravelCloudflareQueue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OssyCodes\\LaravelCloudflareQueue\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "OssyCodes\\LaravelCloudflareQueue\\CloudflareQueueServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
